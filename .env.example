# AgentPay — Environment Variables Template
# Copy this file to .env and fill in your own values.
# NEVER commit the actual .env file to version control.

# ──────────────────────────────────────────────
# Backend
# ──────────────────────────────────────────────

# SQLite database path (default: ./agentpay.db)
DATABASE_URL=sqlite:///./agentpay.db

# API host / port (optional — uvicorn defaults used if omitted)
API_HOST=0.0.0.0
API_PORT=8000

# ──────────────────────────────────────────────
# Frontend (Vite)
# ──────────────────────────────────────────────

# Backend API base URL seen by the browser
VITE_API_BASE_URL=http://localhost:8000

# ──────────────────────────────────────────────
# (Future) External integrations — leave empty for MVP
# ──────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# STRIPE_SECRET_KEY=sk_live_...
